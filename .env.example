# M.W.A.R Digital Platform — environment template.
# Copy to .env for local overrides; never commit a real .env.

# Core
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Field-level encryption key for CNIC (any passphrase; a 32-byte key is derived).
# MUST be set to a strong, secret value in production.
CNIC_ENCRYPTION_KEY=change-me-to-a-secret-passphrase

# Database — SQLite by default; switch to Postgres in production:
# DATABASE_URL=postgres://mwar:mwar@db:5432/mwar

# Email — console backend in dev; real SMTP in production:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@mwar.org.pk

# SMS — console (fake) backend in dev; point at a real gateway in production:
SMS_BACKEND=apps.core.sms.ConsoleSMSBackend
